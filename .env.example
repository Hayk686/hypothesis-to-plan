# ------------------------------------------------------------
# Example environment file for Hypothesis -> Plan
# ------------------------------------------------------------
# Copy this file to `.env` or `.env.local` in the project root and fill in
# the values you want to use locally.
#
# Files named `.env`, `.env.local`, and `.env.*.local` are gitignored.
#
# IMPORTANT:
#   * Do not put private keys in VITE_ variables.
#   * VITE_ variables are inlined into the browser bundle.
#   * The keys below are server-only and are read from process.env by the
#     TanStack Start server routes under src/routes/api.*.ts.
# ------------------------------------------------------------

# Optional. Used by /api/search-papers and the literature core for higher
# Semantic Scholar rate limits. Missing keys fall back to keyless requests or
# seeded demo data when upstream search fails.
SEMANTIC_SCHOLAR_API_KEY=

# Optional. Used as a silent enhancement source when Semantic Scholar returns
# too few useful papers.
NCBI_API_KEY=

# Optional. Used by /api/search-protocols and /api/generate-plan to query
# protocols.io. If missing or failing, the app uses curated protocol fallbacks.
PROTOCOLS_IO_CLIENT_TOKEN=

# ------------------------------------------------------------
# LLM orchestration
# ------------------------------------------------------------
# Optional. Choose "openrouter" or "nvidia". If omitted, the server picks
# OpenRouter when OPENROUTER_API_KEY exists, otherwise NVIDIA when NVIDIA_API_KEY
# exists. If no LLM key is configured, /api/generate-plan still works and marks
# the plan as deterministic fallback.
LLM_PROVIDER=openrouter

# OpenRouter OpenAI-compatible chat completions.
# Free models change over time; pick a current ":free" model from OpenRouter's
# model list if the default is unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_TITLE=Hypothesis to Plan

# NVIDIA NIM / NVIDIA API Catalog OpenAI-compatible chat completions.
# You can set LLM_PROVIDER=nvidia and use either NVIDIA_API_KEY or
# NVIDIA_NIM_API_KEY. Override NVIDIA_MODEL with a model available to your key.
#NVIDIA_API_KEY=
#NVIDIA_NIM_API_KEY=
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#NVIDIA_MODEL=openai/gpt-oss-20b
