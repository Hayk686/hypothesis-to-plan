# ------------------------------------------------------------
# Example environment file for Hypothesis -> Plan
# ------------------------------------------------------------
# Copy this file to `.env` or `.env.local` in the project root and fill in
# the values you want to use locally.
#
# Files named `.env`, `.env.local`, and `.env.*.local` are gitignored.
#
# IMPORTANT:
#   * Do not put private keys in VITE_ variables.
#   * VITE_ variables are inlined into the browser bundle.
#   * The keys below are server-only and are read from process.env by the
#     TanStack Start server routes under src/routes/api.*.ts.
# ------------------------------------------------------------

# Optional. Used by /api/search-papers and the literature core for higher
# Semantic Scholar rate limits. Missing keys fall back to keyless requests or
# seeded demo data when upstream search fails.
SEMANTIC_SCHOLAR_API_KEY=

# Optional. Used as a silent enhancement source when Semantic Scholar returns
# too few useful papers.
NCBI_API_KEY=

# Optional. OpenAlex is used as a broad scholarly-index fallback for literature
# QC. The API has a free daily tier; add the free key for more reliable Vercel
# usage, or at least set an email for polite identification.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Optional. Crossref REST is public without signup. Setting mailto enters the
# polite pool and raises practical rate/concurrency limits.
CROSSREF_MAILTO=

# Optional. Used by /api/search-protocols and /api/generate-plan to query
# protocols.io. If missing or failing, the app uses curated protocol fallbacks.
PROTOCOLS_IO_CLIENT_TOKEN=

# Optional. Used by /api/resolve-materials and /api/generate-plan to verify
# electronics, sensors, boards, and components with live Mouser product data,
# availability, pricing, catalog numbers, and product URLs.
MOUSER_API_KEY=

# Optional. Nexar/Octopart fallback for electronics, sensors, and components
# when Mouser is unavailable. Create a free Nexar app and use its OAuth
# client credentials.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# ------------------------------------------------------------
# LLM orchestration
# ------------------------------------------------------------
# Optional. Choose "auto", "nvidia", or "openrouter".
# - "auto": Tries NVIDIA first, then OpenRouter
# - "nvidia": Tries NVIDIA first, then OpenRouter (if enabled)
# - "openrouter": Tries OpenRouter first, then NVIDIA (if enabled)
LLM_PROVIDER=auto

# Optional. Set to "false" to disable fallback to the secondary provider.
LLM_FALLBACKS_ENABLED=true

# Optional. Timeout in milliseconds for LLM requests (default 55000)
LLM_TIMEOUT_MS=55000

# Optional. Number of times to attempt JSON repair on schema errors (default 1)
LLM_JSON_REPAIR_ATTEMPTS=1

# OpenRouter OpenAI-compatible chat completions.
# Recommended default for stable JSON parsing:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Locally use http://127.0.0.1:5173. On Vercel set this to your production URL,
# e.g. https://your-project.vercel.app.
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_TITLE=Hypothesis to Plan

# NVIDIA NIM / NVIDIA API Catalog OpenAI-compatible chat completions.
# You can set LLM_PROVIDER=nvidia and use either NVIDIA_API_KEY or
# NVIDIA_NIM_API_KEY. Override NVIDIA_MODEL with a model available to your key.
# NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=z-ai/glm-5.1
